{
    "desc": [
        "PACT on the URB NS (rain derates road capacity, HCM-anchored).",
        "Host hyperparameters IDENTICAL to ippo/config1.json, so an arm difference",
        "cannot be an algorithm difference.",
        "Everything under 'ns' and 'pact' is a DECLARED CONSTANT or an arm switch.",
        "If you find yourself tuning one to make a result look better, it belongs",
        "in the ablation table, not in this default (guide II.1)."
    ],

    "training_eps": 4000,

    "batch_size": 64,
    "update_every": 2,
    "lr": 0.0003,
    "num_epochs": 3,
    "num_hidden": 1,
    "widths": [64, 64],
    "clip_eps": 0.2,
    "normalize_advantage": true,
    "entropy_coef": 0.01,

    "ns": {
        "sat_flow": 600.0,
        "period": 100,
        "wet_frac": 0.5,
        "loss": 0.14,
        "mean_preserving": false
    },

    "pact": {
        "r": 1,
        "forget": 0.9995,
        "p0": 10.0,

        "max_trust": 0.5,
        "ff_gain": 1.0,
        "fit_floor": 0.0,
        "ready_updates": 100,
        "fit_window": 200,
        "fit_warmup": 50,

        "pedestal_tau": 400.0,
        "max_offset_s": 240.0,
        "fd_step_s": 30.0,

        "roll_episodes": 100,
        "print_every": 25
    }
}
